<section class="ds-batch color-{{ section.settings.color_scheme }}" id="ds-tandas" aria-labelledby="DSBatch-{{ section.id }}">
  <div class="ds-wrap">
    <h2 class="ds-display ds-h2 ds-batch__title" id="DSBatch-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="ds-batch__intro">{% render 'ds-batch-text', text: section.settings.text %}</div>
    {%- endif -%}
    {%- capture ds_closed -%}{%- render 'ds-batch-state' -%}{%- endcapture -%}
    {%- if ds_closed == '1' -%}
      <p class="ds-batch__closed" role="status">{{ settings.ds_batch_closed_text | escape }}</p>
    {%- else -%}
    {%- liquid
      # La cuenta regresiva solo se muestra si la fecha exacta se puede leer (date devuelve dígitos).
      assign close_s = settings.ds_batch_close_at | date: '%s'
      assign close_check = close_s | plus: 0 | append: ''
    -%}
    {%- if settings.ds_batch_close_at != blank and close_check == close_s -%}
      <div class="ds-countdown" data-ds-countdown="{{ close_s }}" hidden>
        <p class="ds-countdown__label">Faltan para el cierre de pedidos</p>
        <p class="ds-countdown__units" role="timer" aria-live="off">
          <span><b data-unit="d">0</b> <span data-unit-label="d" data-one="día" data-other="días">días</span></span>
          <span><b data-unit="h">00</b> <span data-unit-label="h" data-one="hora" data-other="horas">horas</span></span>
          <span><b data-unit="m">00</b> min</span>
        </p>
        <p class="ds-countdown__done" data-ds-countdown-done hidden>Pedidos cerrados para esta tanda.</p>
      </div>
    {%- endif -%}
    <ol class="ds-steps" role="list">
      {%- for block in section.blocks -%}
        <li class="ds-step{% if block.settings.current %} is-now{% endif %}"{% if block.settings.current %} aria-current="step"{% endif %} {{ block.shopify_attributes }}>
          <span class="ds-step__num" aria-hidden="true">{{ forloop.index }}</span>
          {%- if block.settings.current -%}<span class="ds-step__now">Ahora</span>{%- endif -%}
          <span class="ds-step__when">{% render 'ds-batch-text', text: block.settings.when, escape: true %}</span>
          <p>{% render 'ds-batch-text', text: block.settings.text, escape: true %}</p>
        </li>
      {%- endfor -%}
    </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DS · Tandas de pedidos",
  "class": "ds-batch-wrap",
  "settings": [
    {
      "type": "paragraph",
      "content": "Puedes usar [tanda], [cierre], [horneado] y [despacho]; se reemplazan por las fechas de Ajustes del tema > DS · Tanda de pedidos."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Horneamos por tandas, no para una vitrina."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introducción",
      "default": "<p>Abrimos el menú unos días, reunimos todos los pedidos y los horneamos juntos para una misma fecha de despacho.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colores",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "when",
          "label": "Cuándo",
          "default": "Hasta el [cierre]"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "El menú está abierto."
        },
        {
          "type": "checkbox",
          "id": "current",
          "label": "Resaltar como paso actual",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DS · Tandas de pedidos",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}

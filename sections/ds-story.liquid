<section class="ds-story ds-wrap" id="ds-historia" aria-labelledby="DSStory-{{ section.id }}">
  <div class="ds-story__img">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '480, 750, 1000, 1200', sizes: '(min-width: 990px) 40vw, 100vw', loading: 'lazy' }}
    {%- else -%}
      {% render 'ds-fallback-image', name: 'ds-cookie-box-concept.png', sizes: '(min-width: 990px) 40vw, 100vw', alt: 'Caja rosa abierta con seis galletas sobre papel encerado' %}
    {%- endif -%}
  </div>
  <div class="ds-story__copy">
    <h2 class="ds-display ds-h2" id="DSStory-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    <div class="ds-story__text">{% render 'ds-batch-text', text: section.settings.text %}</div>
    {%- assign facts = section.settings.facts | newline_to_br | split: '<br />' -%}
    {%- if section.settings.facts != blank -%}
      <ul class="ds-facts" role="list">
        {%- for fact in facts -%}{%- assign f = fact | strip -%}{%- if f != blank -%}<li>{{ f | escape }}</li>{%- endif -%}{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DS · Nuestra historia",
  "class": "ds-story-wrap",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto",
      "info": "Vertical. Sin foto se usa la caja de galletas de la marca."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Recetas con memoria cubana, horneadas en Texas."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "textarea",
      "id": "facts",
      "label": "Datos destacados (uno por línea)",
      "default": "Menú abierto por tandas\nHorneado para tu fecha de despacho\nCupos según lo que sale del horno"
    }
  ],
  "presets": [
    {
      "name": "DS · Nuestra historia"
    }
  ]
}
{% endschema %}

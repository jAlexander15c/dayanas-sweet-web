
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{% liquid
  assign chosen_collection = section.settings.collection
  if chosen_collection == blank
    assign chosen_collection = collections.all
  endif
%}
<section class="ds-catalog ds-wrap" id="ds-catalogo" aria-labelledby="CatalogTitle-{{ section.id }}">
  <div class="ds-section-heading"><div><p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="CatalogTitle-{{ section.id }}">{% if chosen_collection.products.size > 0 %}{{ section.settings.live_title | escape }}{% else %}{{ section.settings.title | escape }}{% endif %}</h2></div><p>{% if chosen_collection.products.size > 0 %}{{ section.settings.live_text | escape }}{% else %}{{ section.settings.text | escape }}{% endif %}</p></div>
  {% if chosen_collection.products.size > 0 %}
    <ul class="ds-products" role="list">
    {% for product in chosen_collection.products limit: section.settings.limit %}
      <li>{% render 'card-product', card_product: product, media_aspect_ratio: 'square', image_shape: 'default', show_secondary_image: true, show_vendor: false, show_rating: false, lazy_load: true, quick_add: 'standard', section_id: section.id %}</li>
    {% endfor %}
    </ul>
    <div class="ds-center"><a class="ds-button ds-button--outline" href="{{ chosen_collection.url | default: routes.all_products_collection_url }}">Ver todos los productos</a></div>
  {% else %}
    <div class="ds-concepts-note"><span class="ds-concepts-note__star" aria-hidden="true">✳</span><p><strong>Un adelanto de lo que estamos imaginando.</strong> Productos, fotografías y sabores ilustrativos; el menú y los precios se confirmarán antes de abrir pedidos.</p></div>
    <div class="ds-concepts" role="list">
      <article class="ds-concept" role="listitem"><div class="ds-concept__photo"><img src="{{ 'ds-editorial-cookies.png' | asset_url }}" alt="Imagen ilustrativa de galletas con chocolate" width="1536" height="1024" loading="lazy"><span>01 / GALLETAS</span></div><div class="ds-concept__body"><h3>Galletas para repetir</h3><p>El antojo que empieza con una y termina en otra.</p><span class="ds-concept__status">Menú por confirmar</span></div></article>
      <article class="ds-concept" role="listitem"><div class="ds-concept__photo"><img src="{{ 'ds-brownie.png' | asset_url }}" alt="Imagen ilustrativa de brownies de chocolate" width="1254" height="1254" loading="lazy"><span>02 / POSTRES</span></div><div class="ds-concept__body"><h3>Chocolate sin prisa</h3><p>Una idea para quienes siempre dejan sitio al postre.</p><span class="ds-concept__status">Menú por confirmar</span></div></article>
      <article class="ds-concept" role="listitem"><div class="ds-concept__photo"><img src="{{ 'ds-cookie-box-concept.png' | asset_url }}" alt="Imagen ilustrativa de una caja de seis galletas" width="1254" height="1254" loading="lazy"><span>03 / PARA COMPARTIR</span></div><div class="ds-concept__body"><h3>Una caja de felicidad</h3><p>Porque compartir sabe aún mejor. O casi siempre.</p><span class="ds-concept__status">Menú por confirmar</span></div></article>
    </div>
    <div class="ds-concepts-end"><p>{{ section.settings.empty_text | escape }}</p><a class="ds-button ds-button--outline" href="#ds-universo">Así será nuestra primera hornada <span aria-hidden="true">→</span></a></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "DS · Catálogo boutique",
  "settings": [
    {
      "type": "text",
      "id": "live_title",
      "label": "Título con productos activos",
      "default": "Elige tu próximo antojo."
    },
    {
      "type": "textarea",
      "id": "live_text",
      "label": "Texto con productos activos",
      "default": "Descubre los sabores disponibles y prepara tu próxima caja de felicidad."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "LA COLECCIÓN MÁS DULCE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Amor al primer mordisco."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Descripción",
      "default": "Elige tu próximo antojo. El momento de disfrutarlo lo pones tú."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección (vacía = todos)"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Productos visibles",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "Catálogo vacío: etiqueta",
      "default": "ALGO DELICIOSO ESTÁ POR LLEGAR"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Catálogo vacío: título",
      "default": "Estamos preparando tus próximos favoritos."
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Catálogo vacío: descripción",
      "default": "Muy pronto encontrarás aquí nuestra selección de galletas y postres. Quédate cerca: lo mejor está por salir del horno."
    }
  ],
  "presets": [
    {
      "name": "DS · Catálogo boutique"
    }
  ]
}
{% endschema %}

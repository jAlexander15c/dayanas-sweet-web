
<section class="ds-signoff"><p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2>{% if collections.all.products.size > 0 %}<a class="ds-button ds-button--cream" href="{{ section.settings.link | default: '#ds-catalogo' }}">{{ section.settings.label | escape }} <span aria-hidden="true">→</span></a>{% else %}<a class="ds-button ds-button--cream" href="#ds-catalogo">Descubre lo que viene <span aria-hidden="true">→</span></a>{% endif %}<span class="ds-signoff__star" aria-hidden="true">✳</span></section>

{% schema %}
{
  "name": "DS · Cierre de marca",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "UN ANTOJO. UNA SONRISA. OTRO MORDISCO."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Hazle espacio a lo dulce."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Botón",
      "default": "Encuentra tu favorito"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    }
  ],
  "presets": [
    {
      "name": "DS · Cierre de marca"
    }
  ]
}
{% endschema %}

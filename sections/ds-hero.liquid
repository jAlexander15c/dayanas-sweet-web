{% comment %}
  Portada con diapositivas. En el título, las palabras entre asteriscos se
  destacan en rosa itálica: "Galletas gruesas, *recién* horneadas."
{% endcomment %}
{%- liquid
  assign fallbacks = 'ds-editorial-cookies.png,ds-brownie.png,ds-cookie-box-concept.png' | split: ','
  assign slide_count = section.blocks.size
  assign hero_sizes = '(min-width: 1320px) 560px, (min-width: 750px) 45vw, calc(100vw - 32px)'
  assign first_block = section.blocks.first
  assign h1_text = first_block.settings.title | strip_html | remove: '*' | strip
  if h1_text == blank
    assign h1_text = shop.name
  endif
-%}
{%- if first_block != blank and first_block.settings.image == blank -%}
  {%- liquid
    assign pre_base = fallbacks[0] | remove: '.png'
    assign pre_480 = pre_base | append: '-480.webp' | asset_url
    assign pre_800 = pre_base | append: '-800.webp' | asset_url
    assign pre_1200 = pre_base | append: '-1200.webp' | asset_url
  -%}
  {% comment %}Foto LCP de marca: solo cuando la primera diapositiva no tiene foto propia (esa la precarga Shopify).{% endcomment %}
  {% comment %}theme-check-disable AssetPreload{% endcomment %}
  <link rel="preload" as="image" href="{{ pre_800 }}" imagesrcset="{{ pre_480 }} 480w, {{ pre_800 }} 800w, {{ pre_1200 }} 1200w" imagesizes="{{ hero_sizes }}" fetchpriority="high">
  {% comment %}theme-check-enable AssetPreload{% endcomment %}
{%- endif -%}
<section class="ds-hero ds-wrap" data-ds-hero data-interval="{{ section.settings.interval }}" aria-roledescription="carrusel" aria-label="Destacados">
  <div class="ds-hero__copy">
    <h1 class="visually-hidden">{{ h1_text | escape }}</h1>
    <div class="ds-hero__slides">
      {%- for block in section.blocks -%}
        {%- assign parts = block.settings.title | escape | split: '*' -%}
        <div class="ds-hero__slide{% if forloop.first %} is-on{% endif %}" data-ds-slide {{ block.shopify_attributes }} aria-roledescription="diapositiva" aria-label="{{ forloop.index }} de {{ slide_count }}">
          {%- capture heading -%}
            {%- for part in parts -%}{%- assign mod = forloop.index0 | modulo: 2 -%}{%- if mod == 1 -%}<em>{{ part }}</em>{%- else -%}{{ part }}{%- endif -%}{%- endfor -%}
          {%- endcapture -%}
          <p class="ds-display ds-hero__title" role="heading" aria-level="2">{{ heading }}</p>
          {%- if block.settings.text != blank -%}<p class="ds-hero__text">{% render 'ds-batch-text', text: block.settings.text, escape: true %}</p>{%- endif -%}
          <div class="ds-ctas">
            {%- if block.settings.button_label != blank -%}
              <a class="ds-btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}{% render 'ds-icon', name: 'arrow' %}</a>
            {%- endif -%}
            {%- if block.settings.button2_label != blank -%}
              <a class="ds-btn ds-btn--ghost" href="{{ block.settings.button2_link | default: routes.all_products_collection_url }}">{{ block.settings.button2_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if slide_count > 1 -%}
      <div class="ds-hero__controls">
      <div class="ds-hero__dots" role="group" aria-label="Elegir destacado">
        {%- for block in section.blocks -%}
          <button type="button" class="{% if forloop.first %}is-on{% endif %}" data-ds-dot="{{ forloop.index0 }}" aria-label="Ver destacado {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}><i></i></button>
        {%- endfor -%}
      </div>
      <button type="button" class="ds-motion-control" data-ds-pause aria-pressed="false">Pausar</button>
      </div>
    {%- endif -%}
  </div>
  <div class="ds-hero__art">
    <div class="ds-hero__arch">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img_class = 'ds-hero__img'
          if forloop.first
            assign img_class = 'ds-hero__img is-on'
            assign load = 'eager'
            assign priority = 'high'
          else
            assign load = 'lazy'
            assign priority = 'auto'
          endif
          assign fb_index = forloop.index0 | modulo: 3
        -%}
        {%- if block.settings.image != blank -%}
          {%- if forloop.first -%}
            {{ block.settings.image | image_url: width: 1400 | image_tag: widths: '480, 750, 1000, 1400', sizes: hero_sizes, class: img_class, loading: load, fetchpriority: priority, preload: true }}
          {%- else -%}
            {{ block.settings.image | image_url: width: 1400 | image_tag: widths: '480, 750, 1000, 1400', sizes: hero_sizes, class: img_class, loading: load }}
          {%- endif -%}
        {%- else -%}
          {% render 'ds-fallback-image', name: fallbacks[fb_index], class: img_class, sizes: hero_sizes, loading: load, fetchpriority: priority, alt: '' %}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.tag_label != blank or section.settings.tag_value != blank -%}
      <p class="ds-hero__tag">{{ section.settings.tag_label | escape }}<strong>{{ section.settings.tag_value | escape }}</strong></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DS · Portada",
  "class": "ds-hero-section",
  "settings": [
    {
      "type": "range",
      "id": "interval",
      "label": "Segundos por diapositiva",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "tag_label",
      "label": "Etiqueta naranja: texto",
      "info": "Déjala vacía para ocultarla."
    },
    {
      "type": "text",
      "id": "tag_value",
      "label": "Etiqueta naranja: valor",
      "info": "Por ejemplo un precio: $24.00"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto",
          "info": "Formato vertical o cuadrado. Sin foto se usa una imagen de marca."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "info": "Encierra entre asteriscos la palabra a destacar: Galletas gruesas, *recién* horneadas.",
          "default": "Galletas gruesas, *recién* horneadas."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Borde tostado, centro que todavía se dobla y trozos de chocolate que se derriten al abrir la caja."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Botón principal",
          "default": "Ver el menú"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del botón principal"
        },
        {
          "type": "text",
          "id": "button2_label",
          "label": "Botón secundario"
        },
        {
          "type": "url",
          "id": "button2_link",
          "label": "Enlace del botón secundario"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DS · Portada",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}


<section class="ds-universe" id="ds-universo" aria-labelledby="UniverseTitle-{{ section.id }}">
  <div class="ds-wrap"><p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="UniverseTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2>
  <div class="ds-moments">
  {% for block in section.blocks %}
    <article class="ds-moment ds-moment--{{ forloop.index }}" {{ block.shopify_attributes }}>
      <div class="ds-moment__top"><span>0{{ forloop.index }}</span><span aria-hidden="true">✳</span></div>
      <h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p>
      {% if block.settings.link != blank %}<a class="ds-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
    </article>
  {% endfor %}
  </div></div>
</section>

{% schema %}
{
  "name": "DS · Universo de marca",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "SIEMPRE HAY UNA BUENA EXCUSA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Un dulce para cada momento."
    }
  ],
  "presets": [
    {
      "name": "DS · Universo de marca"
    }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Momento",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Para ti."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descripción",
          "default": "Tu pausa favorita del día."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace opcional"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texto del enlace",
          "default": "Descubrir"
        }
      ]
    }
  ]
}
{% endschema %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="marquee-ticker color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" aria-hidden="true">
  <div class="marquee-ticker__track">
    <span>{{ section.settings.text }}</span>
    <span aria-hidden="true">{{ section.settings.text }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Marquee ticker",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "default": "🍪 Rellenas y generosas ✦ Horneadas cada semana ✦ Envío a los 50 estados ✦ bake with love ✦ Lotes pequeños ✦",
      "label": "Texto del letrero"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "Espaciado de sección"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Marquee ticker"
    }
  ]
}
{% endschema %}

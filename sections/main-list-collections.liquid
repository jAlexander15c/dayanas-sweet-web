{{ 'ds-categories.css' | asset_url | stylesheet_tag }}
{%- assign heading_id = 'ds-category-title-' | append: section.id -%}
<section class="ds-r-menu-section" aria-labelledby="{{ heading_id }}">
  <div class="ds-r-menu-heading"><h1 class="ds-category-page-title" id="{{ heading_id }}">{{ section.settings.title | escape }}</h1></div>
  {% render 'ds-category-grid', blocks: section.blocks, hide_empty: section.settings.hide_empty, show_count: section.settings.show_count, heading_id: heading_id, heading_tag: 'h2' %}
</section>
{% schema %}
{
  "name": "DS · Categorías",
  "class": "ds-r-home",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Nuestras categorías"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Mostrar contador de productos",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_empty",
      "label": "Ocultar categorías sin productos disponibles",
      "default": false
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "limit": 12,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título de respaldo",
          "default": "Galletas",
          "info": "Si hay colección seleccionada, se muestra su título real."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texto del enlace",
          "default": "Ver galletas"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto de categoría"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Descripción de la foto",
          "default": "Caja rosa con galletas de chocolate"
        },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Foto de respaldo",
          "default": "cookies",
          "options": [
            {
              "value": "cookies",
              "label": "Galletas"
            },
            {
              "value": "brownies",
              "label": "Brownies"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}

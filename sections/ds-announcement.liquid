{%- capture ds_closed -%}{%- render 'ds-batch-state' -%}{%- endcapture -%}
{%- liquid
  assign visible_count = 0
  for block in section.blocks
    assign show_when = block.settings.show_when | default: 'always'
    assign show_message = false
    if show_when == 'always'
      assign show_message = true
    elsif show_when == 'open' and ds_closed != '1'
      assign show_message = true
    elsif show_when == 'closed' and ds_closed == '1'
      assign show_message = true
    endif
    if show_message
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}
{%- if visible_count > 0 -%}
{%- capture ds_items -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign show_when = block.settings.show_when | default: 'always'
      assign show_message = false
      if show_when == 'always'
        assign show_message = true
      elsif show_when == 'open' and ds_closed != '1'
        assign show_message = true
      elsif show_when == 'closed' and ds_closed == '1'
        assign show_message = true
      endif
    -%}
    {%- if show_message -%}
      <li class="ds-announce__msg" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
        {%- render 'ds-batch-text', text: block.settings.text, escape: true -%}
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </li>
      <li class="ds-announce__sep" aria-hidden="true">✦</li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{% comment %}Cinta continua: el grupo se duplica (y se repite en JS si es corto) para que el loop no tenga cortes.{% endcomment %}
<div class="ds-announce" data-ds-marquee="{{ section.settings.marquee_speed }}" role="region" aria-label="Anuncios">
  <div class="ds-announce__viewport">
    <div class="ds-announce__track">
      <ul class="ds-announce__group" role="list">{{ ds_items }}</ul>
      <ul class="ds-announce__group" role="list" aria-hidden="true" data-ds-marquee-clone>{{ ds_items }}</ul>
    </div>
  </div>
  <button type="button" class="ds-motion-control ds-announce__pause" data-ds-pause aria-pressed="false" hidden>Pausar</button>
</div>
{%- endif -%}

{% schema %}
{
  "name": "DS · Barra de anuncios",
  "class": "ds-announce-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Puedes usar [tanda], [cierre], [horneado] y [despacho]; se reemplazan por las fechas de Ajustes del tema > DS · Tanda de pedidos."
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Velocidad de la cinta",
      "info": "Píxeles por segundo.",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 45
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "[tanda]: pedidos hasta el [cierre]"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        },
        {
          "type": "select",
          "id": "show_when",
          "label": "Mostrar cuando",
          "options": [
            { "value": "always", "label": "Siempre" },
            { "value": "open", "label": "Menú abierto" },
            { "value": "closed", "label": "Menú cerrado" }
          ],
          "default": "always"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DS · Barra de anuncios",
      "blocks": [
        {
          "type": "message"
        }
      ]
    }
  ]
}
{% endschema %}

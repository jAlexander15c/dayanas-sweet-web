<section class="ds-password" aria-labelledby="ds-password-title">
  <div class="ds-wrap ds-password__wrap">
    <div class="ds-password__card">
      <img
        class="ds-password__logo"
        src="{{ 'ds-logo-horizontal.png' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="360"
        height="116"
        loading="eager"
      >
      <h1 id="ds-password-title" class="ds-display ds-password__title">{{ section.settings.title | escape }}</h1>
      {%- if shop.password_message != blank -%}
        <p class="ds-password__text">{{ shop.password_message | escape }}</p>
      {%- elsif section.settings.text != blank -%}
        <p class="ds-password__text">{% render 'ds-batch-text', text: section.settings.text, escape: true %}</p>
      {%- endif -%}

      {%- form 'customer', class: 'ds-password__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="DsPasswordEmail-{{ section.id }}">Correo electrónico</label>
        <div class="ds-password__field-row">
          <input
            id="DsPasswordEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email | escape }}"
            autocomplete="email"
            autocapitalize="off"
            autocorrect="off"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="DsPasswordEmailError-{{ section.id }}"{% endif %}
          >
          <button class="ds-btn" type="submit">Avisarme</button>
        </div>
        {%- if form.errors -%}
          <p id="DsPasswordEmailError-{{ section.id }}" class="ds-password__message" role="alert">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <p class="ds-password__message ds-password__message--success" role="status">Gracias. Te avisaremos por correo.</p>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div id="ds-password-access" class="ds-password__access" aria-labelledby="ds-password-access-title">
      <h2 id="ds-password-access-title" class="ds-display">Acceso con contraseña</h2>
      {%- form 'storefront_password', class: 'ds-password__form' -%}
        <label for="DsStorefrontPassword-{{ section.id }}">Contraseña</label>
        <div class="ds-password__field-row">
          <input
            id="DsStorefrontPassword-{{ section.id }}"
            type="password"
            name="password"
            autocomplete="current-password"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="DsPasswordAccessError-{{ section.id }}"{% endif %}
          >
          <button class="ds-btn ds-btn--ink" type="submit">Entrar</button>
        </div>
        {%- if form.errors -%}
          <p id="DsPasswordAccessError-{{ section.id }}" class="ds-password__message" role="alert">
            {{ 'general.password_page.login_form_error' | t }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DS · Contraseña",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Volvemos pronto con algo dulce"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "info": "Puedes usar [tanda], [cierre], [horneado] y [despacho].",
      "default": "Estamos preparando la próxima tanda. Déjanos tu correo y te avisaremos cuando la tienda vuelva a abrir."
    }
  ],
  "presets": [
    { "name": "DS · Contraseña" }
  ]
}
{% endschema %}

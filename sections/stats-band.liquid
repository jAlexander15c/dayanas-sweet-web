{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="stats-band color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="stats-band__grid">
      {%- for block in section.blocks -%}
        <div class="stats-band__item" {{ block.shopify_attributes }}>
          <span class="stats-band__number h1">{{ block.settings.number }}</span>
          <span class="stats-band__label caption-with-letter-spacing">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Stats band",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Espaciado de sección"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Estadística",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "default": "100%",
          "label": "Número o cifra"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Descripción de la cifra",
          "label": "Descripción"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats band",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "100%",
            "label": "Mantequilla real, cero margarina"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "48h",
            "label": "De horno a caja, nunca de bodega"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "50",
            "label": "Estados con envío directo"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{%- capture ds_closed -%}{%- render 'ds-batch-state' -%}{%- endcapture -%}
{%- liquid
  assign is_all = false
  if collection.handle == 'all' or collection.handle == blank
    assign is_all = true
  endif
  assign title = collection.title
  if is_all
    assign title = section.settings.all_title
  endif
  # La descripción de la colección siempre se muestra; el texto de respaldo con fechas solo con la tanda abierta.
  assign intro = collection.description
  if intro == blank and ds_closed != '1'
    assign intro = section.settings.fallback_text
  endif
-%}
<section class="ds-chero ds-wrap" aria-labelledby="DSCollection-{{ section.id }}">
  <nav class="ds-chero__crumbs" aria-label="Ruta de navegación">
    <a href="{{ routes.root_url }}">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">{% if is_all %}Menú{% else %}{{ collection.title | escape }}{% endif %}</span>
  </nav>
  {%- comment -%} BreadcrumbList refleja exactamente las migas visibles de arriba. {%- endcomment -%}
  {%- capture ds_crumb_name -%}{% if is_all %}Menú{% else %}{{ collection.title }}{% endif %}{%- endcapture -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": {{ request.origin | append: routes.root_url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ ds_crumb_name | strip | json }}, "item": {{ canonical_url | json }} }
      ]
    }
  </script>
  <div class="ds-chero__grid">
    <div>
      <h1 class="ds-display ds-chero__title" id="DSCollection-{{ section.id }}">{{ title | escape }}</h1>
      {%- if intro != blank -%}
        <div class="ds-chero__text rte">{% render 'ds-batch-text', text: intro %}</div>
      {%- endif -%}
    </div>
    {%- if section.settings.show_batch -%}
      <ul class="ds-chero__batch" role="list" aria-label="Fechas de pedidos">
        {%- if ds_closed == '1' -%}
          <li>{% render 'ds-icon', name: 'clock' %}<span>{{ settings.ds_batch_closed_text | escape }}</span></li>
        {%- endif -%}
        {% render 'ds-order-dates' %}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "DS · Encabezado de menú",
  "class": "ds-chero-wrap",
  "settings": [
    {
      "type": "text",
      "id": "all_title",
      "label": "Título para \"todos los productos\"",
      "default": "Todo el menú"
    },
    {
      "type": "richtext",
      "id": "fallback_text",
      "label": "Texto si la colección no tiene descripción",
      "info": "Puedes usar [apertura], [cierre], [envio] y [pedidos]. Los marcadores anteriores siguen siendo compatibles.",
      "default": "<p>Hecho a mano y preparado por encargo. Elige tus favoritos y los enviaremos el [envio].</p>"
    },
    {
      "type": "checkbox",
      "id": "show_batch",
      "label": "Mostrar fechas de pedidos",
      "default": true
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}

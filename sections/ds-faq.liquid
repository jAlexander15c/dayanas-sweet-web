<section class="ds-faq ds-wrap" id="ds-preguntas" aria-labelledby="DSFaq-{{ section.id }}">
  <div class="ds-faq__side">
    <h2 class="ds-display ds-h2" id="DSFaq-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
  </div>
  <div class="ds-faq__items">
    {%- for block in section.blocks -%}
      <details class="ds-qa"{% if forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question | escape }}{% render 'ds-icon', name: 'plus' %}</summary>
        <div class="ds-qa__a rte">{%- if settings.ds_batch_open == false and block.settings.closed_answer != blank -%}{% render 'ds-batch-text', text: block.settings.closed_answer %}{%- else -%}{% render 'ds-batch-text', text: block.settings.answer %}{%- endif -%}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "DS · Preguntas frecuentes",
  "class": "ds-faq-wrap",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Antes de pedir"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Descripción",
      "default": "Lo que conviene saber antes de elegir, para que tu caja llegue justo cuando la necesitas."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Cómo hago mi pedido?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta",
          "info": "Puedes usar [tanda], [cierre], [horneado] y [despacho].",
          "default": "<p>Elige tus productos y agrégalos al carrito mientras el menú esté abierto.</p>"
        },
        {
          "type": "richtext",
          "id": "closed_answer",
          "label": "Respuesta cuando la tanda está cerrada",
          "info": "Opcional. Si está vacía, se usa la respuesta habitual."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DS · Preguntas frecuentes",
      "blocks": [
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}

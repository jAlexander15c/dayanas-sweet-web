{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "header": {
      "type": "header",
      "settings": {
        "color_scheme": "scheme-1",
        "menu_color_scheme": "scheme-1",
        "logo_position": "middle-left",
        "menu": "menu-principal-ds",
        "menu_type_desktop": "dropdown",
        "sticky_header_type": "always",
        "show_line_separator": false,
        "enable_country_selector": false,
        "enable_language_selector": false,
        "mobile_logo_position": "center",
        "margin_bottom": 0,
        "padding_top": 12,
        "padding_bottom": 12
      },
      "disabled": true
    },
    "ds-announcement": {
      "type": "ds-announcement",
      "settings": {
        "marquee_speed": 45
      },
      "blocks": {
        "msg-close": {
          "type": "message",
          "settings": {
            "text": "Pedidos hasta el [cierre]",
            "link": "",
            "show_when": "open"
          }
        },
        "msg-bake": {
          "type": "message",
          "settings": {
            "text": "Próximo envío: [envio]",
            "link": "",
            "show_when": "open"
          }
        },
        "msg-ship": {
          "type": "message",
          "settings": {
            "text": "Envíos gratis desde $100",
            "link": ""
          }
        },
        "msg-closed": {
          "type": "message",
          "settings": {
            "text": "[mensaje_cerrado]",
            "link": "",
            "show_when": "closed"
          }
        },
        "msg-opening": {
          "type": "message",
          "settings": {
            "text": "Apertura de pedidos: [apertura]",
            "link": "",
            "show_when": "closed"
          }
        }
      },
      "block_order": [
        "msg-close",
        "msg-bake",
        "msg-ship",
        "msg-closed",
        "msg-opening"
      ],
      "disabled": true
    },
    "redesign": {
      "type": "ds-redesign-header",
      "settings": {}
    }
  },
  "order": [
    "redesign",
    "ds-announcement",
    "header"
  ]
}

{% comment %}
  Iconos de trazo de Tabler Icons (MIT), mismo grosor en todo el tema.
  Acepta:
    - name: arrow | left | right | plus | check | clock | truck | box
{% endcomment %}
<svg class="ds-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'arrow' -%}<path d="M5 12h14M13 18l6-6M13 6l6 6"/>
    {%- when 'left' -%}<path d="M15 6l-6 6 6 6"/>
    {%- when 'right' -%}<path d="M9 6l6 6-6 6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'check' -%}<path d="M5 12l5 5L20 7"/>
    {%- when 'clock' -%}<path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"/><path d="M12 7v5l3 3"/>
    {%- when 'truck' -%}<path d="M5 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M15 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"/><path d="M5 17H3V6a1 1 0 0 1 1-1h9v12m-4 0h6m4 0h2v-6h-8m0-5h5l3 5"/>
    {%- when 'box' -%}<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>
  {%- endcase -%}
</svg>

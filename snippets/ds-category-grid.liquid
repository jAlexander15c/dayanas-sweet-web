{% comment %}
  Shared storefront categories. Parameters: blocks, hide_empty, show_count, heading_id.
  Metafield presence is independent of visibility: hiding every category must not
  reactivate the legacy blocks. A padded natural-title rank breaks order ties.
{% endcomment %}
{%- paginate collections by 250 -%}
  {%- liquid
    assign configured = false
    assign category_count = 0
    assign sorted_collections = collections | sort_natural: 'title'
  -%}
  {%- capture category_keys -%}
    {%- for category in sorted_collections -%}
      {%- liquid
        if category.metafields.ds.categoria != nil or category.metafields.ds.en_inicio != nil or category.metafields.ds.orden != nil
          assign configured = true
        endif
        assign visible = false
        if category.metafields.ds.categoria.value == true and category.metafields.ds.en_inicio.value == true
          assign visible = true
        endif
        if hide_empty
          assign available_products = category.products | where: 'available', true
          if available_products.size == 0
            assign visible = false
          endif
        endif
      -%}
      {%- if visible -%}
        {%- assign order = category.metafields.ds.orden.value | default: 9999999999 | prepend: '00000000000000000000' | slice: -20, 20 -%}
        {%- assign title_rank = forloop.index | prepend: '000000' | slice: -6, 6 -%}
        {{- order -}}::{{- title_rank -}}::{{- category.handle -}}|
        {%- assign category_count = category_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- capture cards -%}
    {%- if configured -%}
      {%- assign category_keys = category_keys | split: '|' | sort -%}
      {%- for key in category_keys -%}
        {%- assign handle = key | split: '::' | last -%}
        {%- assign category = collections[handle] -%}
        <li class="ds-category-item">
          <a class="ds-r-category" href="{{ category.url }}" aria-label="{{ category.title | escape }}">
            {%- if category.image != blank -%}
              {%- assign image_alt = category.image.alt -%}
              {%- if image_alt == category.title -%}{%- assign image_alt = '' -%}{%- endif -%}
              <img class="ds-r-category-photo" src="{{ category.image | image_url: width: 1200 }}" width="{{ category.image.width }}" height="{{ category.image.height }}" alt="{{ image_alt | escape }}" loading="lazy" sizes="(min-width: 990px) 50vw, (min-width: 601px) 50vw, 100vw">
            {%- endif -%}
            <div class="ds-r-category-caption">
              <h3>{{ category.title | escape }}</h3>
              {%- if show_count -%}<span class="ds-category-count">{{ 'sections.collection_list.product_count' | t: count: category.all_products_count }}</span>{%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- for block in blocks -%}
        {%- if block.type == 'category' -%}
          {%- liquid
            assign category = block.settings.collection
            assign visible = true
            if hide_empty
              assign available_products = category.products | where: 'available', true
              if available_products.size == 0
                assign visible = false
              endif
            endif
            assign category_title = category.title | default: block.settings.title
            assign category_url = category.url | default: routes.all_products_collection_url
            assign category_image = category.image | default: block.settings.image
            assign image_alt = category_image.alt | default: block.settings.image_alt
            if image_alt == category_title
              assign image_alt = ''
            endif
          -%}
          {%- if visible -%}
            {%- assign category_count = category_count | plus: 1 -%}
            <li class="ds-category-item" {{ block.shopify_attributes }}>
              <a class="ds-r-category" href="{{ category_url }}" aria-label="{{ category_title | escape }}">
                {%- if category_image != blank -%}
                  <img class="ds-r-category-photo" src="{{ category_image | image_url: width: 1200 }}" width="{{ category_image.width }}" height="{{ category_image.height }}" alt="{{ image_alt | escape }}" loading="lazy">
                {%- endif -%}
                <div class="ds-r-category-caption">
                  <h3>{{ category_title | escape }}</h3>
                  {%- if show_count and category != blank -%}<span class="ds-category-count">{{ 'sections.collection_list.product_count' | t: count: category.all_products_count }}</span>{%- endif -%}
                </div>
              </a>
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}
  <ul class="ds-r-category-grid ds-category-grid" data-category-count="{{ category_count }}" role="list" aria-labelledby="{{ heading_id }}">{{ cards }}</ul>
  {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
{%- endpaginate -%}

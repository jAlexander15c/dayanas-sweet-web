{%- comment -%}
  Textos compartidos de Ajustes del tema > DS · Pedidos y envíos.
  [apertura], [pedidos], [cierre], [envio], [mensaje_cerrado].
  Compatibilidad: [tanda], [horneado], [despacho].
  Omite una frase completa si depende de un campo pendiente.
  text: contenido; escape: true para texto plano. Valores siempre escapados.
{%- endcomment -%}
{%- liquid
  assign out = text | default: ''
  if escape
    assign out = out | escape
  endif
  assign tokens = 'apertura,pedidos,tanda,cierre,horneado,envio,despacho,mensaje_cerrado' | split: ','
  for token in tokens
    assign key = '[' | append: token | append: ']'
    if out contains key
      case token
        when 'apertura'
          assign value = settings.ds_batch_start
        when 'pedidos', 'tanda'
          assign value = settings.ds_batch_name
        when 'cierre'
          assign value = settings.ds_batch_close
        when 'horneado'
          assign value = settings.ds_batch_bake
        when 'envio', 'despacho'
          assign value = settings.ds_batch_ship
        when 'mensaje_cerrado'
          assign value = settings.ds_batch_closed_text
      endcase
      assign value = value | default: '' | strip
      if value == blank
        assign out = ''
        break
      endif
      assign value = value | escape
      assign out = out | replace: key, value
    endif
  endfor
  echo out
-%}

{% comment %}
  Tarjeta de producto de la capa DS: etiqueta de caja con agregar rápido.
  Acepta:
    - product: {Object}
    - section_id: {string} para el formulario de producto de Dawn
    - lazy: {boolean} carga diferida de la imagen (por defecto true)
    - rank_badge: {string} etiqueta por posición en ventas (la pone ds-product-rail)
  Etiquetas del producto:
    - "badge:Texto" muestra una etiqueta sobre la foto (por ejemplo badge:Favorito)
  La sección que lo usa debe cargar product-form.js.
{% endcomment %}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign sold_out = false
  unless product.available
    assign sold_out = true
  endunless
  assign badge = ''
  for tag in product.tags
    if tag contains 'badge:'
      assign badge = tag | remove_first: 'badge:' | strip
      break
    endif
  endfor
  if rank_badge != blank
    assign badge = rank_badge
  endif
  capture ds_closed
    render 'ds-batch-state'
  endcapture
  # Tarjetas con opciones, suscripción o cantidad mínima van a la ficha en lugar de agregar rápido.
  assign needs_choice = false
  if product.requires_selling_plan or product.has_only_default_variant == false or variant.quantity_rule.min > 1
    assign needs_choice = true
  endif
  # "Quedan N" solo en productos de una sola variante; con varias el número no sería del producto.
  assign low = false
  if ds_closed != '1' and product.has_only_default_variant and variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= settings.ds_low_stock
    assign low = true
  endif
  # Precio: el de la variante disponible más barata; si no hay disponibles, el mínimo del producto.
  assign card_price = product.price_min
  assign price_found = false
  for v in product.variants
    if v.available
      if price_found == false or v.price < card_price
        assign card_price = v.price
        assign price_found = true
      endif
    endif
  endfor
  assign form_id = 'DSCard-' | append: section_id | append: '-' | append: product.id
  assign img_alt = product.featured_media.alt | default: product.title | escape
  assign card_heading = heading_level | default: 'h3'
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
  assign card_sizes = image_sizes | default: '(min-width: 990px) 300px, 70vw'
-%}
<article class="ds-card{% if sold_out %} is-out{% endif %}">
  <a class="ds-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 720 | image_tag: widths: '300, 450, 600, 720', sizes: card_sizes, loading: loading, class: 'ds-card__img', alt: img_alt }}
      {%- if product.media[1] -%}
        {{ product.media[1] | image_url: width: 720 | image_tag: widths: '300, 450, 600, 720', sizes: card_sizes, loading: 'lazy', class: 'ds-card__img ds-card__img--alt', alt: '' }}
      {%- endif -%}
    {%- else -%}
      <span class="ds-card__ph">Foto próximamente</span>
    {%- endif -%}
    {%- if sold_out -%}
      <span class="ds-badge ds-badge--ink">Agotado en esta tanda</span>
    {%- elsif badge != blank -%}
      <span class="ds-badge">{{ badge | escape }}</span>
    {%- endif -%}
  </a>
  <div class="ds-card__body">
    <{{ card_heading }} class="ds-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></{{ card_heading }}>
    {%- assign excerpt = product.description | replace: '</p>', ' </p>' | replace: '<br', ' <br' | strip_html | strip_newlines | truncatewords: 10, '…' -%}
    {%- if excerpt != blank -%}<p class="ds-card__desc">{{ excerpt }}</p>{%- endif -%}
    {%- if low -%}<p class="ds-card__stock">Quedan {{ variant.inventory_quantity }} en esta tanda</p>{%- endif -%}
    <div class="ds-card__foot">
      <span class="ds-card__price">
        {%- if product.price_varies -%}Desde {% endif -%}
        {{ card_price | money }}
      </span>
      {%- if sold_out or ds_closed == '1' -%}
        <span class="ds-add is-disabled">{% if sold_out %}Agotado{% else %}Cerrado{% endif %}</span>
      {%- elsif needs_choice == false -%}
        <product-form class="ds-card__form" data-section-id="{{ section_id }}" data-hide-errors="true">
          {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" name="add" class="ds-add" aria-label="Agregar {{ product.title | escape }} al carrito">
              {% render 'ds-icon', name: 'plus' %}<span>Agregar</span>
              {%- render 'loading-spinner' -%}
            </button>
            <p class="ds-card__error" data-ds-card-error role="status" aria-live="polite" hidden></p>
          {%- endform -%}
        </product-form>
      {%- else -%}
        <a class="ds-add" href="{{ product.url }}" aria-label="Elegir opciones de {{ product.title | escape }}">Elegir</a>
      {%- endif -%}
    </div>
  </div>
</article>

{% comment %}
  Barra de compra fija en celular. Envía el formulario principal de la ficha,
  así respeta la variante y la cantidad elegidas. Se muestra cuando el botón
  principal sale de pantalla (assets/ds-motion.js).
  Uso desde un bloque "Liquid personalizado": {% render 'ds-sticky-buy', product: product %}
{% endcomment %}
{%- capture ds_closed -%}{%- render 'ds-batch-state' -%}{%- endcapture -%}
{%- if product.available and ds_closed != '1' -%}
  <div class="ds-sticky-buy" data-ds-sticky hidden>
    <div class="ds-sticky-buy__info">
      <strong>{{ product.title | escape }}</strong>
      <span id="DSStickyPrice-{{ section.id }}">{{ product.selected_or_first_available_variant.price | money }}</span>
    </div>
    <button type="button" class="ds-btn" data-ds-sticky-submit{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>Agregar al carrito</button>
  </div>
{%- endif -%}
